# Copy to .env and fill in. Never commit real keys.
# Real market-data provider (optional). Without a key the app runs fully
# in zero-key simulation mode and labels all data as Simulated.
FINNHUB_KEY=
# Shared secret for POST /api/ingest (manual ingestion trigger) and
# POST /api/migrate/retry. The internal 60s scheduler needs no secret.
# External POSTs are rejected (401) when this is unset or mismatched.
INGEST_SECRET=
